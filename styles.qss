/* 🎨 Estilo global lavanda elegante */

* {
    font-family: "Segoe UI";
}

QDialog, QMainWindow {
    background-color: #F5F3FB;
}

/* --- Botones --- */
QPushButton {
    background-color: #7A5ACB;
    color: white;
    font-weight: bold;
    border-radius: 10px;
    padding: 8px 12px;
}
QPushButton:hover {
    background-color: #9B87E0;
}

/* --- Campos de texto --- */
QLineEdit, QComboBox, QDateEdit, QTextEdit {
    border: 2px solid #C5B4E3;
    border-radius: 8px;
    padding: 6px;
    background: white;
    font-size: 13px;
}

/* --- Etiquetas --- */
QLabel {
    font-size: 15px;
    color: #7A5ACB;
}

/* --- Tablas --- */
QTableWidget {
    background: white;
    border-radius: 8px;
    gridline-color: #D9CFF3;
    font-size: 13px;
}
QHeaderView::section {
    background-color: #D9CFF3;
    font-weight: bold;
    padding: 5px;
    border: none;
}

/* --- Menú lateral --- */
QListWidget {
    background-color: #EDE8F7;
    border: none;
    border-radius: 10px;
    padding: 6px;
}
QListWidget::item {
    padding: 10px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background-color: #7A5ACB;
    color: white;
}

/* --- Ventanas principales --- */
QMainWindow {
    border: 2px solid #C5B4E3;
    border-radius: 10px;
}

/* =========================
   Reglas específicas para la pantalla de presentación (splash)
   Estas reglas son más concretas (objectName) y por tanto anulan
   la regla general de QLabel que tenías y permiten aumentar
   únicamente las fuentes del splash sin afectar el resto.
   Ajusta los valores (px) abajo si quieres más/menos grandes.
   ========================= */

QLabel#system_name {
    font-size: 56px;      /* Título principal grande */
    font-weight: 900;
    color: #5E3DB3;
}

QLabel#company {
    font-size: 34px;      /* Nombre de la empresa */
    font-weight: 800;
    color: #222222;
}

QLabel#rif {
    font-size: 22px;      /* RIF */
    font-weight: 700;
    color: #444444;
}

/* Logo placeholder dentro del splash: si el label tiene objectName='logo_lbl' puedes ajustar */
QLabel#logo_lbl {
    font-size: 20px;
    font-weight: 900;
    color: #7A5ACB;
}

/* Botón continuar dentro del splash (objectName 'cont_btn') */
QPushButton#cont_btn {
    font-size: 20px;
    padding: 14px 26px;
    font-weight: 900;
}

/* Si por alguna razón tu splash no tiene objectName en los widgets,
   otra alternativa es especificar por jerarquía: el Dialog que tenga
   objectName "splash" y buscar etiquetas dentro de él. */
QDialog#splash QLabel#system_name { font-size: 56px; }
QDialog#splash QLabel#company { font-size: 34px; }
QDialog#splash QLabel#rif { font-size: 22px; }
QDialog#splash QPushButton#cont_btn { font-size: 20px; }